module panel_line_bank (
  hClk,
  AUD_MCLK_d,
  lineBuffer_we,
  lineBuffer_wa,
  lineBuffer_ra,
  hColorPixelLCD,
  mem_6,
  \bank_q[0] 
)
;
input hClk;
input AUD_MCLK_d;
input lineBuffer_we;
input [13:0] lineBuffer_wa;
input [9:0] lineBuffer_ra;
input [17:0] hColorPixelLCD;
output mem_6;
output [17:0] \bank_q[0] ;
wire mem_5;
wire [35:18] DO;
wire VCC;
wire GND;
  LUT2 mem_s3 (
    .F(mem_5),
    .I0(lineBuffer_wa[13]),
    .I1(mem_6) 
);
defparam mem_s3.INIT=4'h4;
  LUT4 mem_s4 (
    .F(mem_6),
    .I0(lineBuffer_wa[10]),
    .I1(lineBuffer_wa[11]),
    .I2(lineBuffer_wa[12]),
    .I3(lineBuffer_we) 
);
defparam mem_s4.INIT=16'h0100;
  SDPX9B mem_mem_0_0_s (
    .DO({DO[35:18],\bank_q[0] [17:0]}),
    .CLKA(hClk),
    .CEA(mem_5),
    .CLKB(AUD_MCLK_d),
    .CEB(VCC),
    .OCE(GND),
    .RESET(GND),
    .ADA({lineBuffer_wa[9:0],GND,GND,VCC,VCC}),
    .ADB({lineBuffer_ra[9:0],GND,GND,GND,GND}),
    .BLKSELA({GND,GND,GND}),
    .BLKSELB({GND,GND,GND}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,hColorPixelLCD[17:0]}) 
);
defparam mem_mem_0_0_s.BIT_WIDTH_0=18;
defparam mem_mem_0_0_s.BIT_WIDTH_1=18;
defparam mem_mem_0_0_s.READ_MODE=1'b0;
defparam mem_mem_0_0_s.RESET_MODE="SYNC";
defparam mem_mem_0_0_s.BLK_SEL_0=3'b000;
defparam mem_mem_0_0_s.BLK_SEL_1=3'b000;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* panel_line_bank */
