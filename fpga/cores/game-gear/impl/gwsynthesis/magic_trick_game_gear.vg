  tx_busy,
  uart_rx_val,
  uart_rx_data
)
;
input AUD_MCLK_d;
input n1445_6;
input ESP32_MCU_D12_d;
input AUD_RESET_d;
input uart_tx_val_Z;
input [7:0] uart_tx_data_Z;
