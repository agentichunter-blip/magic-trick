module panel_line_bank (
  hClk,
  AUD_MCLK_d,
  lineBuffer_we,
  lineBuffer_wa,
  lineBuffer_ra,
  hColorPixelLCD,
  mem_6,
  \bank_q[0] 
)
;
input hClk;
input AUD_MCLK_d;
input lineBuffer_we;
input [13:0] lineBuffer_wa;
input [9:0] lineBuffer_ra;
input [17:0] hColorPixelLCD;
output mem_6;
output [17:0] \bank_q[0] ;
wire mem_5;
wire [35:18] DO;
wire VCC;
wire GND;
  LUT4 mem_s3 (
    .F(mem_5),
    .I0(lineBuffer_wa[10]),
    .I1(lineBuffer_wa[12]),
    .I2(lineBuffer_wa[13]),
    .I3(mem_6) 
);
