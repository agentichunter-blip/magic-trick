module panel_line_bank (
  hClk,
  AUD_MCLK_d,
  lineBuffer_we,
  lineBuffer_wa,
  lineBuffer_ra,
  hColorPixelLCD,
  \bank_q[0] 
)
;
input hClk;
input AUD_MCLK_d;
input lineBuffer_we;
input [13:0] lineBuffer_wa;
input [9:0] lineBuffer_ra;
input [17:0] hColorPixelLCD;
output [17:0] \bank_q[0] ;
wire mem_5;
wire mem_6;
wire [35:18] DO;
wire VCC;
wire GND;
  LUT3 mem_s3 (
    .F(mem_5),
    .I0(lineBuffer_wa[12]),
    .I1(lineBuffer_wa[13]),
    .I2(mem_6) 
);
