module usb_rx_buf (
  PHY_CLKOUT,
  n574_5,
  usb_rxpktval,
  pkt_fifo_rd_pktfin_4,
  tx_busy,
  usb_rxact,
  usb_rxrdy_7,
  usb_rxval,
  n19_7,
  usb_rxdat,
  ep3_rx_dval,
  pkt_fifo_wr_num,
  ep3_rx_data
)
;
input PHY_CLKOUT;
input n574_5;
input usb_rxpktval;
input pkt_fifo_rd_pktfin_4;
input tx_busy;
input usb_rxact;
input usb_rxrdy_7;
input usb_rxval;
input n19_7;
input [7:0] usb_rxdat;
output ep3_rx_dval;
output [12:11] pkt_fifo_wr_num;
output [7:0] ep3_rx_data;
wire n16_3;
wire n71_3;
wire n91_4;
wire n86_5;
wire n54_5;
wire n12_5;
wire n8_5;
wire n58_5;
wire pkt_fifo_wr_act;
wire pkt_fifo_wr_pktval;
wire pkt_fifo_rd;
wire pkt_fifo_rd_dval;
wire c_fifo_rd;
wire pkt_fifo_wr;
wire n279_3;
wire c_fifo_afull;
wire c_fifo_empty;
wire [7:0] pkt_fifo_wr_data;
wire [7:0] pkt_fifo_rd_data;
wire VCC;
wire GND;
  LUT2 n16_s0 (
    .F(n16_3),
    .I0(usb_rxpktval),
    .I1(pkt_fifo_rd_pktfin_4) 
);
defparam n16_s0.INIT=4'h8;
  LUT3 n71_s0 (
    .F(n71_3),
    .I0(tx_busy),
    .I1(ep3_rx_dval),
    .I2(c_fifo_rd) 
);
defparam n71_s0.INIT=8'h10;
  LUT2 n91_s1 (
    .F(n91_4),
    .I0(c_fifo_empty),
    .I1(c_fifo_rd) 
);
defparam n91_s1.INIT=4'h4;
  LUT4 n86_s1 (
    .F(n86_5),
    .I0(tx_busy),
    .I1(ep3_rx_dval),
    .I2(c_fifo_rd),
    .I3(c_fifo_empty) 
);
defparam n86_s1.INIT=16'h0001;
  LUT2 n54_s1 (
    .F(n54_5),
    .I0(c_fifo_afull),
    .I1(n279_3) 
);
defparam n54_s1.INIT=4'h4;
  LUT3 n12_s1 (
    .F(n12_5),
    .I0(usb_rxact),
    .I1(usb_rxrdy_7),
    .I2(pkt_fifo_rd_pktfin_4) 
);
