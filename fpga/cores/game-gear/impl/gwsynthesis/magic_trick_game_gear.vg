module USB2_0_SoftPHY_Top (
  usb_busreset,
  fclk_960M,
  PHY_TERMSELECT,
  PHY_CLKOUT,
  n574_5,
  PHY_TXVALID,
  pll_locked,
  usb_rxdp_i_d,
  usb_rxdn_i_d,
  usb_term_dn_io_in,
  usb_term_dp_io_in,
  PHY_XCVRSELECT,
  rst_cnt,
  PHY_OPMODE,
  PHY_DATAOUT,
  PHY_TXREADY,
  PHY_RXVALID,
  PHY_RXACTIVE,
  PHY_RXERROR,
  n19_7,
  pullup_en_6,
  usb_dp_io_5,
  n12_6,
  n6_6,
  PHY_DATAIN,
  PHY_LINESTATE,
  usb_dxp_io,
  usb_dxn_io
)
;
input usb_busreset;
input fclk_960M;
input PHY_TERMSELECT;
input PHY_CLKOUT;
input n574_5;
input PHY_TXVALID;
input pll_locked;
input usb_rxdp_i_d;
input usb_rxdn_i_d;
input usb_term_dn_io_in;
input usb_term_dp_io_in;
input [0:0] PHY_XCVRSELECT;
input [7:5] rst_cnt;
input [1:0] PHY_OPMODE;
input [7:0] PHY_DATAOUT;
output PHY_TXREADY;
output PHY_RXVALID;
output PHY_RXACTIVE;
output PHY_RXERROR;
output n19_7;
output pullup_en_6;
output usb_dp_io_5;
output n12_6;
output n6_6;
output [7:0] PHY_DATAIN;
output [1:0] PHY_LINESTATE;
inout usb_dxp_io;
inout usb_dxn_io;
wire VCC;
wire GND;
