module gowin_dpb_snapshot (
  xClk,
  QSPI_CLK_d,
  buffer_write,
  buffer_address,
  qspi_cart_read_address,
  buffer_data,
  primitive_q_b
)
;
input xClk;
input QSPI_CLK_d;
input buffer_write;
input [8:0] buffer_address;
input [9:1] qspi_cart_read_address;
input [15:0] buffer_data;
output [15:0] primitive_q_b;
wire [15:0] DOA;
wire VCC;
wire GND;
  DPB snapshot_ram (
    .DOA(DOA[15:0]),
    .DOB(primitive_q_b[15:0]),
    .CLKA(xClk),
    .CEA(VCC),
    .CLKB(QSPI_CLK_d),
    .CEB(VCC),
    .OCEA(GND),
    .OCEB(GND),
    .RESETA(GND),
    .RESETB(GND),
    .WREA(buffer_write),
    .WREB(GND),
    .ADA({GND,buffer_address[8:0],GND,GND,VCC,VCC}),
    .ADB({GND,qspi_cart_read_address[9:1],GND,GND,GND,GND}),
    .BLKSELA({GND,GND,GND}),
    .BLKSELB({GND,GND,GND}),
    .DIA(buffer_data[15:0]),
    .DIB({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND}) 
);
defparam snapshot_ram.BIT_WIDTH_0=16;
defparam snapshot_ram.BIT_WIDTH_1=16;
defparam snapshot_ram.BLK_SEL_0=3'b000;
defparam snapshot_ram.BLK_SEL_1=3'b000;
defparam snapshot_ram.READ_MODE0=1'b0;
defparam snapshot_ram.READ_MODE1=1'b0;
defparam snapshot_ram.RESET_MODE="SYNC";
defparam snapshot_ram.WRITE_MODE0=2'b00;
defparam snapshot_ram.WRITE_MODE1=2'b00;
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* gowin_dpb_snapshot */
