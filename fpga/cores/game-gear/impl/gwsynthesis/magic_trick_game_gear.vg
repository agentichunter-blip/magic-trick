module fifo1k (
  qDataValid_Z,
  n5_3,
  xClk,
  n463_6,
  qData,
  fifo_empty,
  \RAMIn_din[1] 
)
;
input qDataValid_Z;
input n5_3;
input xClk;
input n463_6;
input [15:0] qData;
output fifo_empty;
output [15:0] \RAMIn_din[1] ;
wire VCC;
wire GND;
  \~fifo.fifo1k  fifo_inst (
    .qDataValid_Z(qDataValid_Z),
    .n5_3(n5_3),
    .xClk(xClk),
    .n463_6(n463_6),
    .qData(qData[15:0]),
    .fifo_empty(fifo_empty),
    .\RAMIn_din[1] (\RAMIn_din[1] [15:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* fifo1k */
