module Fixed_Point_Divider_Top (
  PHY_CLKOUT,
  s_dte1_rate_Z,
  div_cmpl,
  div_out
)
;
input PHY_CLKOUT;
input [30:0] s_dte1_rate_Z;
output div_cmpl;
output [28:3] div_out;
wire VCC;
wire GND;
  \~qdiv.Fixed_Point_Divider_Top  u_fra_div (
    .PHY_CLKOUT(PHY_CLKOUT),
    .s_dte1_rate_Z(s_dte1_rate_Z[30:0]),
