  PHY_TXREADY,
  usb_txval,
  PHY_RXACTIVE,
  PHY_RXVALID,
  PHY_RXERROR,
  PHY_LINESTATE,
  rst_cnt,
  uart_txdat,
  DESCROM_RDAT,
  PHY_DATAIN,
  interface_alter_i,
  PHY_TXVALID,
  usb_rxact,
  usb_txpktfin,
  setup_active,
  usb_rxval,
  usb_rxpktval,
  usb_txact,
  usb_busreset,
  PHY_TERMSELECT,
  usb_txpop,
  interface_update,
  PHY_DATAOUT,
  PHY_OPMODE,
  usb_rxdat,
  DESCROM_RADDR,
  PHY_XCVRSELECT,
  endpt_sel,
  interface_alter_o,
