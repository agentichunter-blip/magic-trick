create_generated_clock -name xclk2 -source [get_ports {CLK_FPGA}] -master_clock exclk -divide_by 1 -multiply_by 4 [get_pins {u_Gowin_PLL/PLLA_inst/CLKOUT0}]
create_generated_clock -name pclk -source [get_ports {CLK_FPGA}] -master_clock exclk -divide_by 1 -multiply_by 1 [get_pins {u_Gowin_PLL/PLLA_inst/CLKOUT1}]
create_generated_clock -name hclk -source [get_ports {CLK_FPGA}] -master_clock exclk -divide_by 2 -multiply_by 1 [get_pins {u_Gowin_PLL/PLLA_inst/CLKOUT2}]
create_generated_clock -name gclk -source [get_ports {CLK_FPGA}] -master_clock exclk -divide_by 4 -multiply_by 1 [get_pins {u_Gowin_PLL/PLLA_inst/CLKOUT3}]
create_generated_clock -name xclk -source [get_ports {CLK_FPGA}] -master_clock exclk -divide_by 1 -multiply_by 2 [get_pins {u_Gowin_PLL/PLLA_inst/CLKOUT4}]

// Audio serialization uses gclk with an alternate-cycle enable (ModRetro 18.11):
// there is no divided audio clock domain any more.

create_clock -name sclk -period 25 [get_ports {QSPI_CLK}]
create_clock -name exclk -period 29.802322 [get_ports {CLK_FPGA}]

set_clock_groups -asynchronous -group [get_clocks {pclk}] -group [get_clocks {hclk}]
set_clock_groups -asynchronous -group [get_clocks {pclk}] -group [get_clocks {gclk}]
set_clock_groups -asynchronous -group [get_clocks {hclk}] -group [get_clocks {gclk}]

set_max_delay -from [get_ports {CART_D[*]}] -to [get_clocks {hclk}] 13
set_max_delay -from [get_clocks {hclk}] -to  [get_ports {CART_A[*]}] 14
set_max_delay -from [get_clocks {hclk}] -to  [get_ports {CART_WR}] 14
set_max_delay -from [get_clocks {hclk}] -to  [get_ports {CART_RD}] 14
set_max_delay -from [get_clocks {hclk}] -to  [get_ports {CART_CS}] 14
set_max_delay -from [get_clocks {hclk}] -to  [get_ports {LINK_SD}] 14
set_max_delay -from [get_clocks {hclk}] -to  [get_ports {CART_D[*]}] 14

create_clock -name ck24 -period 41.666667 -waveform {0 20.833333} [get_ports {CLK_24MHz}]

set_clock_groups -asynchronous -group [get_clocks {pclk}] -group [get_clocks {hclk}]
set_clock_groups -asynchronous -group [get_clocks {pclk}] -group [get_clocks {gclk}]
set_clock_groups -asynchronous -group [get_clocks {hclk}] -group [get_clocks {gclk}]

// USB Clocks
create_generated_clock -name PHY_CLKOUT -source [get_ports {CLK_24MHz}] -master_clock ck24 -divide_by 16 -multiply_by 40 [get_pins {u_usb_top/u_Gowin_PLL_USB/PLLA_inst/CLKOUT1}]
create_generated_clock -name fclk_960M -source [get_ports {CLK_24MHz}] -master_clock ck24 -divide_by 1 -multiply_by 40 [get_nets {u_usb_top/fclk_960M}]
create_generated_clock -name clk24p -source [get_ports {CLK_24MHz}] -master_clock ck24 -divide_by 1 -multiply_by 1 [get_pins {u_usb_top/u_Gowin_PLL_USB/PLLA_inst/CLKOUT2}]
create_clock -name usbintsclk -period 8 -waveform {0 4} [get_nets {u_usb_top/u_USB_SoftPHY_Top/usb2_0_softphy/u_usb_20_phy_utmi/u_usb2_0_softphy/u_usb_phy_hs/sclk}] -add
set_clock_groups -asynchronous -group [get_clocks {PHY_CLKOUT}] -group [get_clocks {fclk_960M}]
set_clock_groups -asynchronous -group [get_clocks {PHY_CLKOUT}] -group [get_clocks {usbintsclk}]

# Board shell additions (from the Game Gear core). Review resolved collections in vendor STA.
# Never false-path the bundled audio data bus: held data has a bounded budget.
set_max_delay -from [get_regs {u_emu_system_top/audio_cdc/held_*_s0}] -to [get_regs {u_emu_system_top/audio_cdc/sample_*_s0}] 20
# Gray pointer bits must arrive within one source cycle (xclk ~14.9 ns).
set_max_delay -from [get_regs {u_emu_system_top/video_cdc/fifo/wgray_*_s0}] -to [get_regs {u_emu_system_top/video_cdc/fifo/wm_*_s0}] 14
set_max_delay -from [get_regs {u_emu_system_top/video_cdc/fifo/rgray_*_s0}] -to [get_regs {u_emu_system_top/video_cdc/fifo/rm_*_s0}] 50

# NES (nes_board_core.sv): the NES runs on xclk gated by the GW5A DCE
# (nes_clock_gate.sv). No generated clock: a generated clock on the DCE output
# starts at 0 ns there and loses the PLL-to-DCE delay xclk keeps, which made
# same-edge hold checks into xclk logic fail falsely and setup look better than
# it is. STA traces xclk through the DCE instead, with real delays.
# Every path from a NES-clocked register is a two-cycle path (the enable never
# makes two NES edges closer than three xclk, and xclk logic uses NES outputs
# from the second edge after a NES edge on; see TIMING in nes_board_core.sv).
# Hold stays at the launching edge. Paths from xclk logic into the NES are one
# cycle (default).
# Gowin's "*" does not cross hierarchy levels here, so every level that holds
# NES registers is listed (from the synthesized netlist; regenerate if the NES
# RTL hierarchy changes). The last patterns are nes_board_core's own nclk glue.
# Gowin ignores a multicycle path with -from only: -to names the xclk clock
# (all xclk logic, and the NES registers, which STA clocks by xclk via the DCE).
set_multicycle_path -from [get_regs {u_emu_system_top/core/nes/* u_emu_system_top/core/nes/apu/* u_emu_system_top/core/nes/apu/Dmc/* u_emu_system_top/core/nes/apu/Dmc/iREG_SAVESTATE_APU_DMC1/* u_emu_system_top/core/nes/apu/Dmc/iREG_SAVESTATE_APU_DMC2/* u_emu_system_top/core/nes/apu/Noi/* u_emu_system_top/core/nes/apu/Noi/EnvNoi/* u_emu_system_top/core/nes/apu/Noi/LenNoi/* u_emu_system_top/core/nes/apu/Squ1/* u_emu_system_top/core/nes/apu/Squ1/EnvSq/* u_emu_system_top/core/nes/apu/Squ1/LenSq/* u_emu_system_top/core/nes/apu/Squ2/* u_emu_system_top/core/nes/apu/Squ2/EnvSq/* u_emu_system_top/core/nes/apu/Squ2/LenSq/* u_emu_system_top/core/nes/apu/Tri/* u_emu_system_top/core/nes/apu/Tri/LenTri/* u_emu_system_top/core/nes/apu/frame_counter/* u_emu_system_top/core/nes/apu/frame_counter/iREG_SAVESTATE_APU_FCT/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_CH0/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_CH1/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_CH2/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_CH3/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_CH4/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_TOP/* u_emu_system_top/core/nes/clockgen_pause/* u_emu_system_top/core/nes/cpu/cpu_0/cpu_0/* u_emu_system_top/core/nes/cpu/cpu_0/cpu_0/ireg_savestate_t80_1/* u_emu_system_top/core/nes/cpu/cpu_0/cpu_0/ireg_savestate_t80_2/* u_emu_system_top/core/nes/cpu/cpu_0/cpu_0/ireg_savestate_t80_3/* u_emu_system_top/core/nes/dma/* u_emu_system_top/core/nes/iREG_SAVESTATE_TOP/* u_emu_system_top/core/nes/multi_mapper/map28/* u_emu_system_top/core/nes/multi_mapper/map66/* u_emu_system_top/core/nes/multi_mapper/map69/* u_emu_system_top/core/nes/multi_mapper/map69/iREG_SAVESTATE_MAP1/* u_emu_system_top/core/nes/multi_mapper/map71/* u_emu_system_top/core/nes/multi_mapper/mmc1/* u_emu_system_top/core/nes/multi_mapper/mmc1/iREG_SAVESTATE_MAP1/* u_emu_system_top/core/nes/multi_mapper/mmc2/* u_emu_system_top/core/nes/multi_mapper/mmc2/iREG_SAVESTATE_MAP1/* u_emu_system_top/core/nes/multi_mapper/mmc3/* u_emu_system_top/core/nes/multi_mapper/mmc3/iREG_SAVESTATE_MAP1/* u_emu_system_top/core/nes/multi_mapper/mmc3/iREG_SAVESTATE_MAP2/* u_emu_system_top/core/nes/multi_mapper/mmc3/iREG_SAVESTATE_MAP3/* u_emu_system_top/core/nes/multi_mapper/mmc4/* u_emu_system_top/core/nes/multi_mapper/vrc24/* u_emu_system_top/core/nes/multi_mapper/vrc24/vrc4irq/* u_emu_system_top/core/nes/multi_mapper/vrc24/vrc4irq/iREG_SAVESTATE_MAP1/* u_emu_system_top/core/nes/ppu/* u_emu_system_top/core/nes/ppu/address_gen/* u_emu_system_top/core/nes/ppu/bg_painter/* u_emu_system_top/core/nes/ppu/clock/* u_emu_system_top/core/nes/ppu/clock/iREG_SAVESTATE/* u_emu_system_top/core/nes/ppu/iREG_SAVESTATE_PPU/* u_emu_system_top/core/nes/ppu/iREG_SAVESTATE_PPU_DECAY/* u_emu_system_top/core/nes/ppu/palette_ram/* u_emu_system_top/core/nes/ppu/palette_ram/iREG_SAVESTATE_PAL0/* u_emu_system_top/core/nes/ppu/palette_ram/iREG_SAVESTATE_PAL1/* u_emu_system_top/core/nes/ppu/palette_ram/iREG_SAVESTATE_PAL2/* u_emu_system_top/core/nes/ppu/palette_ram/iREG_SAVESTATE_PAL3/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite0/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite1/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite2/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite3/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite4/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite5/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite6/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite7/* u_emu_system_top/core/nes/ppu/spriteeval/* u_emu_system_top/core/nes/ppu/spriteeval/iREG_SAVESTATE/* u_emu_system_top/core/nes/ppu/vram0/* u_emu_system_top/core/nes/ppu/vram0/iREG_SAVESTATE/* u_emu_system_top/core/nes/savestates/* u_emu_system_top/core/nes/statemanager/* u_emu_system_top/core/ss_reg_ext/* u_emu_system_top/core/cpu_rd_q* u_emu_system_top/core/cpu_wr_q* u_emu_system_top/core/ppu_rd_q* u_emu_system_top/core/ppu_wr_q* u_emu_system_top/core/cpu_din* u_emu_system_top/core/ppu_din* u_emu_system_top/core/joy1_bits* u_emu_system_top/core/joy2_bits* u_emu_system_top/core/last_joypad_clock*}] -to [get_clocks {xclk}] -setup -end 2
set_multicycle_path -from [get_regs {u_emu_system_top/core/nes/* u_emu_system_top/core/nes/apu/* u_emu_system_top/core/nes/apu/Dmc/* u_emu_system_top/core/nes/apu/Dmc/iREG_SAVESTATE_APU_DMC1/* u_emu_system_top/core/nes/apu/Dmc/iREG_SAVESTATE_APU_DMC2/* u_emu_system_top/core/nes/apu/Noi/* u_emu_system_top/core/nes/apu/Noi/EnvNoi/* u_emu_system_top/core/nes/apu/Noi/LenNoi/* u_emu_system_top/core/nes/apu/Squ1/* u_emu_system_top/core/nes/apu/Squ1/EnvSq/* u_emu_system_top/core/nes/apu/Squ1/LenSq/* u_emu_system_top/core/nes/apu/Squ2/* u_emu_system_top/core/nes/apu/Squ2/EnvSq/* u_emu_system_top/core/nes/apu/Squ2/LenSq/* u_emu_system_top/core/nes/apu/Tri/* u_emu_system_top/core/nes/apu/Tri/LenTri/* u_emu_system_top/core/nes/apu/frame_counter/* u_emu_system_top/core/nes/apu/frame_counter/iREG_SAVESTATE_APU_FCT/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_CH0/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_CH1/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_CH2/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_CH3/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_CH4/* u_emu_system_top/core/nes/apu/iREG_SAVESTATE_APU_TOP/* u_emu_system_top/core/nes/clockgen_pause/* u_emu_system_top/core/nes/cpu/cpu_0/cpu_0/* u_emu_system_top/core/nes/cpu/cpu_0/cpu_0/ireg_savestate_t80_1/* u_emu_system_top/core/nes/cpu/cpu_0/cpu_0/ireg_savestate_t80_2/* u_emu_system_top/core/nes/cpu/cpu_0/cpu_0/ireg_savestate_t80_3/* u_emu_system_top/core/nes/dma/* u_emu_system_top/core/nes/iREG_SAVESTATE_TOP/* u_emu_system_top/core/nes/multi_mapper/map28/* u_emu_system_top/core/nes/multi_mapper/map66/* u_emu_system_top/core/nes/multi_mapper/map69/* u_emu_system_top/core/nes/multi_mapper/map69/iREG_SAVESTATE_MAP1/* u_emu_system_top/core/nes/multi_mapper/map71/* u_emu_system_top/core/nes/multi_mapper/mmc1/* u_emu_system_top/core/nes/multi_mapper/mmc1/iREG_SAVESTATE_MAP1/* u_emu_system_top/core/nes/multi_mapper/mmc2/* u_emu_system_top/core/nes/multi_mapper/mmc2/iREG_SAVESTATE_MAP1/* u_emu_system_top/core/nes/multi_mapper/mmc3/* u_emu_system_top/core/nes/multi_mapper/mmc3/iREG_SAVESTATE_MAP1/* u_emu_system_top/core/nes/multi_mapper/mmc3/iREG_SAVESTATE_MAP2/* u_emu_system_top/core/nes/multi_mapper/mmc3/iREG_SAVESTATE_MAP3/* u_emu_system_top/core/nes/multi_mapper/mmc4/* u_emu_system_top/core/nes/multi_mapper/vrc24/* u_emu_system_top/core/nes/multi_mapper/vrc24/vrc4irq/* u_emu_system_top/core/nes/multi_mapper/vrc24/vrc4irq/iREG_SAVESTATE_MAP1/* u_emu_system_top/core/nes/ppu/* u_emu_system_top/core/nes/ppu/address_gen/* u_emu_system_top/core/nes/ppu/bg_painter/* u_emu_system_top/core/nes/ppu/clock/* u_emu_system_top/core/nes/ppu/clock/iREG_SAVESTATE/* u_emu_system_top/core/nes/ppu/iREG_SAVESTATE_PPU/* u_emu_system_top/core/nes/ppu/iREG_SAVESTATE_PPU_DECAY/* u_emu_system_top/core/nes/ppu/palette_ram/* u_emu_system_top/core/nes/ppu/palette_ram/iREG_SAVESTATE_PAL0/* u_emu_system_top/core/nes/ppu/palette_ram/iREG_SAVESTATE_PAL1/* u_emu_system_top/core/nes/ppu/palette_ram/iREG_SAVESTATE_PAL2/* u_emu_system_top/core/nes/ppu/palette_ram/iREG_SAVESTATE_PAL3/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite0/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite1/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite2/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite3/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite4/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite5/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite6/* u_emu_system_top/core/nes/ppu/sprite_gen/sprite7/* u_emu_system_top/core/nes/ppu/spriteeval/* u_emu_system_top/core/nes/ppu/spriteeval/iREG_SAVESTATE/* u_emu_system_top/core/nes/ppu/vram0/* u_emu_system_top/core/nes/ppu/vram0/iREG_SAVESTATE/* u_emu_system_top/core/nes/savestates/* u_emu_system_top/core/nes/statemanager/* u_emu_system_top/core/ss_reg_ext/* u_emu_system_top/core/cpu_rd_q* u_emu_system_top/core/cpu_wr_q* u_emu_system_top/core/ppu_rd_q* u_emu_system_top/core/ppu_wr_q* u_emu_system_top/core/cpu_din* u_emu_system_top/core/ppu_din* u_emu_system_top/core/joy1_bits* u_emu_system_top/core/joy2_bits* u_emu_system_top/core/last_joypad_clock*}] -to [get_clocks {xclk}] -hold -end 1
# Game configuration decoded from the info block while the NES clock is stopped
# (loader, nes_board_core.sv), constant while the game runs; flags_hide flips
# once during the reset sequence and nes_reset is released once, both on a NES
# edge (or while the core is held in reset). Their paths through the mapper
# logic into the caches and the enable are two-cycle paths like the NES's own.
set_multicycle_path -from [get_regs {u_emu_system_top/core/mapper_flags* u_emu_system_top/core/prg_mask* u_emu_system_top/core/chr_mask* u_emu_system_top/core/chr_ram* u_emu_system_top/core/chr_base* u_emu_system_top/core/flags_hide* u_emu_system_top/core/info* u_emu_system_top/core/nes_reset*}] -to [get_clocks {xclk}] -setup -end 2
set_multicycle_path -from [get_regs {u_emu_system_top/core/mapper_flags* u_emu_system_top/core/prg_mask* u_emu_system_top/core/chr_mask* u_emu_system_top/core/chr_ram* u_emu_system_top/core/chr_base* u_emu_system_top/core/flags_hide* u_emu_system_top/core/info* u_emu_system_top/core/nes_reset*}] -to [get_clocks {xclk}] -hold -end 1
report_timing -setup -max_paths 400 -max_common_paths 1
